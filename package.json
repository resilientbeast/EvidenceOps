{
  "name": "evidenceops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "datahub:smoke": "node --env-file-if-exists=.env.local scripts/datahub-mcp-smoke.mjs",
    "datahub:seed": "node --env-file-if-exists=.env.local scripts/datahub-seed.mjs",
    "datahub:tools": "node --env-file-if-exists=.env.local scripts/datahub-mcp-tools.mjs",
    "datahub:call": "node --env-file-if-exists=.env.local scripts/datahub-mcp-call.mjs",
    "datahub:mcp-bridge": "node --env-file-if-exists=.env.local scripts/datahub-mcp-bridge.mjs",
    "ai:bridge": "node --env-file-if-exists=.env.local scripts/aimlapi-bridge.mjs",
    "cockroach:seed": "node --env-file-if-exists=.env scripts/seed-cockroach-memory.mjs",
    "cockroach:phase3:verify": "node --env-file-if-exists=.env scripts/verify-cockroach-phase3.mjs",
    "bedrock:reasoning:smoke": "node --env-file-if-exists=.env scripts/bedrock-converse-smoke.mjs",
    "bedrock:anthropic-native:smoke": "node --env-file-if-exists=.env scripts/bedrock-reasoning-smoke.mjs",
    "bedrock:models": "node --env-file-if-exists=.env scripts/bedrock-list-models.mjs",
    "bedrock:converse:smoke": "node --env-file-if-exists=.env scripts/bedrock-converse-smoke.mjs",
    "bedrock:converse:tool-smoke": "node --env-file-if-exists=.env scripts/bedrock-converse-tool-smoke.mjs",
    "postgres:bootstrap": "powershell -ExecutionPolicy Bypass -File infra/postgres/bootstrap-local.ps1",
    "postgres:api": "powershell -ExecutionPolicy Bypass -File infra/postgres/start-rest-bridge.ps1",
    "postgres:smoke": "node --env-file-if-exists=.env.local scripts/postgres-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.58",
    "drizzle-orm": "0.45.2",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

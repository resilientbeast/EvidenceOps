# EvidenceOps — CockroachDB x AWS
# Copy this file to .env and fill in the required values. Never commit .env.

# CockroachDB Cloud (required from phase 2 onward)
# URL-encode any special characters in the SQL-user password.
COCKROACHDB_URL=postgresql://app_user:REPLACE_WITH_URL_ENCODED_PASSWORD@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
# Optional. Leave blank when the runtime trusts the CockroachDB Cloud CA via
# the operating system; otherwise set an absolute path to the downloaded CA.
COCKROACHDB_CA_CERT_PATH=
# Synthetic unresolved incident used by the phase-3 live console.
RECALLOPS_ACTIVE_INCIDENT_ID=40000000-0000-4000-8000-000000000006

# AWS Bedrock (required from phase 2 onward)
AWS_REGION=us-east-1
# Local authentication: use either AWS_PROFILE or the credential variables.
# On AWS deployment, leave all four blank and use the workload's IAM role.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Bedrock-only API key for local development. When this is set, the phase-2
# seed script does not require the AWS-wide credential variables above.
AWS_BEARER_TOKEN_BEDROCK=

# Titan embedding model must produce 1024 dimensions to match VECTOR(1024).
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Bedrock reasoning model used by the four-role investigation flow in phase 4.
BEDROCK_REASONING_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_REASONING_MAX_TOKENS=4096

# CockroachDB Managed MCP Server (phase 6). The deployed custom client uses a
# dedicated service-account API key; interactive Codex OAuth tokens do not go here.
COCKROACHDB_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACHDB_MCP_CLUSTER_ID=0fa1dbb1-cdfc-4ff4-9e2d-884774e6b60a
COCKROACHDB_MCP_API_KEY=
COCKROACHDB_MCP_DATABASE=defaultdb
# auto uses MCP when all three MCP values are present, otherwise SQL. Use mcp
# in production to fail closed instead of silently bypassing Managed MCP.
COCKROACHDB_CATALOG_MODE=auto

# CockroachDB Cloud cluster-health evidence (phase 7). ccloud uses its own
# local authenticated session; do not put its user token or a service-account
# secret in this file. A failed or unavailable CLI check is recorded as
# citeable unknown evidence and never blocks an investigation.
CCLOUD_COMMAND=ccloud
CCLOUD_CLUSTER_NAME=your-cockroach-cluster
CCLOUD_HEALTH_TIMEOUT_MS=5000
CCLOUD_HEALTH_CACHE_MS=30000

# CockroachDB Agent Skills table-statistics evidence (phase 8). This is a
# fixed, read-only SHOW STATISTICS diagnostic on public.incidents.
COCKROACHDB_STATS_DATABASE=defaultdb

# Local operator authentication. Use a unique long password and session secret
# outside development; never commit populated values.
LOCAL_AUTH_EMAIL=operator@evidenceops.local
LOCAL_AUTH_PASSWORD=
LOCAL_AUTH_SESSION_SECRET=

# Persistent organization settings are encrypted before being stored in
# CockroachDB. Generate once with a cryptographically secure random 32-byte
# value encoded as base64; never rotate it without a planned data re-encryption.
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional legacy PostgreSQL/AIMLAPI settings retained during migration.
# ---------------------------------------------------------------------------

# PostgreSQL / pgvector local memory
POSTGRES_MEMORY_URL=
POSTGRES_MEMORY_API_URL=

# AIMLAPI model-backed investigation
AIMLAPI_KEY=
AIMLAPI_MODEL=openai/gpt-4.1-mini
AIMLAPI_BRIDGE_URL=http://127.0.0.1:7332/v1/chat/completions
AIMLAPI_BRIDGE_PORT=7332
AIMLAPI_BRIDGE_TOKEN=

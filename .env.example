# DataHub
DATAHUB_GMS_URL=http://localhost:8080
# Optional public DataHub frontend fallback. Local demo reads GMS directly.
DATAHUB_FRONTEND_URL=http://localhost:9002
# Use a dedicated, least-privilege service-account token. Do not use a personal
# access token or enable mutation tools for this read-only preflight.
DATAHUB_GMS_TOKEN=
# Candidate pin. The compatibility smoke test is the release gate; do not
# present this pair as compatible until it succeeds against the local stack.
DATAHUB_MCP_VERSION=0.6.0
DATAHUB_MCP_COMMAND=uvx
# Optional: short-lived writer token used only by `npm run datahub:seed`.
# Never reuse the read-only MCP token for this value.
DATAHUB_SEED_TOKEN=
DATAHUB_LIVE_SOURCE_URN=urn:li:dataset:(urn:li:dataPlatform:hive,fct_users_created,PROD)
# Runtime catalog path. "auto" keeps GraphQL working until the optional local
# MCP bridge is healthy; use "mcp" for a strict runtime-MCP demo.
DATAHUB_CONTEXT_MODE=auto
DATAHUB_MCP_BRIDGE_URL=http://127.0.0.1:7331
# Set a random local secret before starting the bridge. Never expose it to the browser.
DATAHUB_MCP_BRIDGE_TOKEN=

# PostgreSQL / pgvector local agent memory
POSTGRES_MEMORY_URL=
# Required by the Cloudflare-compatible app runtime; served by the local Docker bridge.
POSTGRES_MEMORY_API_URL=

# AIMLAPI model-backed agent. This key stays server-side; the browser never sees it.
# GPT-4.1 mini is OpenAI-compatible through https://api.aimlapi.com/v1.
AIMLAPI_KEY=
AIMLAPI_MODEL=openai/gpt-4.1-mini
AIMLAPI_BRIDGE_URL=http://127.0.0.1:7332/v1/chat/completions
# Recommended: a separate random local bridge token. If omitted, AIMLAPI_KEY is used only on loopback.
AIMLAPI_BRIDGE_TOKEN=

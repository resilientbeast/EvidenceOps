# Copy this file to .env.local. Leave optional integrations blank until their
# local service is running. Never commit .env.local or real credentials.

# PostgreSQL / pgvector durable memory
# `npm run postgres:bootstrap` fills POSTGRES_MEMORY_URL automatically when blank.
POSTGRES_MEMORY_URL=
POSTGRES_MEMORY_API_URL=

# DataHub local, read-only catalog context (optional)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_GMS_TOKEN=
DATAHUB_MCP_VERSION=0.6.0
DATAHUB_MCP_COMMAND=uvx
DATAHUB_SEED_TOKEN=
DATAHUB_LIVE_SOURCE_URN=urn:li:dataset:(urn:li:dataPlatform:hive,fct_users_created,PROD)
DATAHUB_CONTEXT_MODE=auto
DATAHUB_MCP_BRIDGE_URL=http://127.0.0.1:7331
DATAHUB_MCP_BRIDGE_PORT=7331
DATAHUB_MCP_BRIDGE_TOKEN=

# AIMLAPI model-backed investigation (optional)
AIMLAPI_KEY=
AIMLAPI_MODEL=openai/gpt-4.1-mini
AIMLAPI_BRIDGE_URL=http://127.0.0.1:7332/v1/chat/completions
AIMLAPI_BRIDGE_PORT=7332
# Set a distinct random local token when possible. If blank, the bridge uses
# AIMLAPI_KEY only on loopback.
AIMLAPI_BRIDGE_TOKEN=
